{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "the-flux-capacitor",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-24",
  "durable_objects": {
    "bindings": [
      { "name": "VISITOR_COUNTER", "class_name": "VisitorCounter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VisitorCounter"] }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "zanderbooyzen@gmail.com",
      "allowed_sender_addresses": ["mail@zanderbooyzen.com"]
    }
  ]
}
